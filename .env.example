DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-strong-32-character-secret
DB_CONNECTION_STRING=Host=localhost;Port=8181;Database=lensee;Username=lensee_user;Password=change-me
ASPNETCORE_ENVIRONMENT=Development
FRONTEND_API_BASE_URL=http://localhost:5000
CORS_ALLOWED_ORIGINS=http://localhost:3001
DATABASE_AUTO_MIGRATE=true
DATABASE_BASELINE_EXISTING_SCHEMA=true
RATE_LIMITING_PERMIT_LIMIT=120
RATE_LIMITING_WINDOW_SECONDS=60
RATE_LIMITING_QUEUE_LIMIT=0
JWT_ISSUER=Lensee
JWT_AUDIENCE=Lensee.App
SHOPIFY_ENABLED=false
# Set these only when Shopify is enabled. Keep SHOPIFY_WEBHOOK_SECRET in your secret store.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_STORE_DOMAIN=<your-store>.myshopify.com
SHOPIFY_ONLINE_LOCATION_ID=
SHOPIFY_COD_GATEWAY_NAME_1=Cash on Delivery
SHOPIFY_WEBHOOK_MAX_BODY_BYTES=262144
SHOPIFY_PAYLOAD_RETENTION_DAYS=30
HOSTING_TRUSTED_PROXY_NETWORK=<caddy-docker-network-cidr>
