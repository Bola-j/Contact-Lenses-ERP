DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-strong-32-character-secret
DB_CONNECTION_STRING=Host=localhost;Port=8181;Database=lensee;Username=lensee_user;Password=change-me
ASPNETCORE_ENVIRONMENT=Development
FRONTEND_API_BASE_URL=http://localhost:5000
CORS_ALLOWED_ORIGINS=http://localhost:3001
DATABASE_AUTO_MIGRATE=true
DATABASE_BASELINE_EXISTING_SCHEMA=true
RATE_LIMITING_PERMIT_LIMIT=120
RATE_LIMITING_WINDOW_SECONDS=60
RATE_LIMITING_QUEUE_LIMIT=0
REPORTING_MAX_EXPORT_ROWS=10000
REPORTING_QUESTPDF_LICENSE=Community
REPORTING_COMPANY_NAME_AR=لينسي
REPORTING_COMPANY_NAME_EN=Lensee
# Optional PNG/JPEG logo bytes encoded as a single-line base64 value.
REPORTING_LOGO_BASE64=
REPORTING_ADDRESS_AR=
REPORTING_ADDRESS_EN=
REPORTING_PHONE=
REPORTING_TAX_NUMBER=
REPORTING_COMMERCIAL_REGISTRATION=
REPORTING_CURRENCY_CODE=EGP
JWT_ISSUER=Lensee
JWT_AUDIENCE=Lensee.App
SHOPIFY_ENABLED=false
# Keep Shopify disabled in local development. Configure the production store only in production settings.
SHOPIFY_WEBHOOK_SECRET=
# Compatibility-only local setting; production uses signed HMAC webhooks.
SHOPIFY_LEGACY_WEBHOOK_PATH_SECRET=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ONLINE_LOCATION_ID=
SHOPIFY_COD_GATEWAY_NAME_1=
SHOPIFY_WEBHOOK_MAX_BODY_BYTES=262144
SHOPIFY_PAYLOAD_RETENTION_DAYS=30
# Optional one-time UTC activation cutoff (ISO 8601 with Z). Empty captures first enabled startup.
SHOPIFY_ACTIVATION_AT_UTC=
# Optional read-only recovery. Inject the Admin API token via the deployment secret facility.
SHOPIFY_RECONCILIATION_ENABLED=false
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2026-07
SHOPIFY_RECONCILIATION_INTERVAL_MINUTES=15
HOSTING_TRUSTED_PROXY_NETWORK=<caddy-docker-network-cidr>
