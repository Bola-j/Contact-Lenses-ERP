{
  "info": {
    "name": "Lensee Lens Catalog Seed",
    "_postman_id": "2c6d5f0a-4587-4b68-92d8-lens-seed0001",
    "description": "Seeds Clear Vision medical lens and sample solution catalog data through the Lensee HTTP API. It logs in as Admin, creates/updates categories, brands, products, and creates missing SKUs through the same backend generator used by the application.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://portal.lensee-egypt.com"
    },
    {
      "key": "adminUsername",
      "value": "admin"
    },
    {
      "key": "adminPassword",
      "value": "Admin123!"
    },
    {
      "key": "rateLimitBackoffMs",
      "value": "65000"
    },
    {
      "key": "requestThrottleMs",
      "value": "550",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login as Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin login succeeded', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('accessToken', body.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Seed Lens Catalog Through API",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1"
          ]
        },
        "description": "The request itself is a lightweight API ping. The test script performs the seed using pm.sendRequest."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const baseUrl = pm.variables.get('baseUrl') || pm.collectionVariables.get('baseUrl');",
              "function authHeaders() {",
              "  const token = pm.collectionVariables.get('accessToken');",
              "  return {",
              "    Authorization: `Bearer ${token}`,",
              "    'Content-Type': 'application/json'",
              "  };",
              "}",
              "",
              "async function loginAdmin() {",
              "  const username = pm.variables.get('adminUsername') || pm.collectionVariables.get('adminUsername');",
              "  const password = pm.variables.get('adminPassword') || pm.collectionVariables.get('adminPassword');",
              "  return new Promise((resolve, reject) => {",
              "    pm.sendRequest({",
              "      url: `${baseUrl}/api/v1/auth/login`,",
              "      method: 'POST',",
              "      header: { 'Content-Type': 'application/json' },",
              "      body: {",
              "        mode: 'raw',",
              "        raw: JSON.stringify({ username, password })",
              "      }",
              "    }, (error, response) => {",
              "      if (error) {",
              "        reject(error);",
              "        return;",
              "      }",
              "      if (response.code < 200 || response.code >= 300) {",
              "        reject(new Error(`Admin re-login failed with HTTP ${response.code}: ${response.text()}`));",
              "        return;",
              "      }",
              "      const body = response.json();",
              "      pm.collectionVariables.set('accessToken', body.accessToken);",
              "      resolve(body.accessToken);",
              "    });",
              "  });",
              "}",
              "",
              "const colors = [",
              "  'Green',",
              "  'Green 2T',",
              "  'Marine',",
              "  'Blue',",
              "  'True Sapphire',",
              "  'Gray',",
              "  'Galaxy Gray',",
              "  'Selena Gray',",
              "  'Hazel',",
              "  'Pure Hazel',",
              "  'Sunset',",
              "  'Jewel Brown'",
              "];",
              "",
              "function sleep(ms) {",
              "  return new Promise((resolve) => setTimeout(resolve, ms));",
              "}",
              "",
              "",
              "async function throttleRequest() {",
              "  const throttleMs = Number(pm.collectionVariables.get('requestThrottleMs') || pm.variables.get('requestThrottleMs') || 550);",
              "  if (throttleMs > 0) {",
              "    await sleep(throttleMs);",
              "  }",
              "}",
              "async function request(method, path, body, attempt = 1) {",
              "  await throttleRequest();",
              "  return new Promise((resolve, reject) => {",
              "    pm.sendRequest({",
              "      url: `${baseUrl}${path}`,",
              "      method,",
              "      header: authHeaders(),",
              "      body: body === undefined ? undefined : {",
              "        mode: 'raw',",
              "        raw: JSON.stringify(body)",
              "      }",
              "    }, (error, response) => {",
              "      if (error) {",
              "        reject(error);",
              "        return;",
              "      }",
              "",
              "      const status = response.code;",
              "      if (status === 429 && attempt <= 12) {",
              "        const backoffMs = Number(pm.collectionVariables.get('rateLimitBackoffMs') || pm.variables.get('rateLimitBackoffMs') || 65000);",
              "        console.warn(`Rate limit hit on ${method} ${path}. Waiting ${backoffMs}ms before retry ${attempt}.`);",
              "        sleep(backoffMs).then(() => request(method, path, body, attempt + 1).then(resolve).catch(reject));",
              "        return;",
              "      }",
              "",
              "      if (status === 401 && attempt === 1) {",
              "        console.warn(`Access token expired on ${method} ${path}. Re-authenticating and retrying once.`);",
              "        loginAdmin().then(() => request(method, path, body, attempt + 1).then(resolve).catch(reject)).catch(reject);",
              "        return;",
              "      }",
              "",
              "      if (status >= 200 && status < 300) {",
              "        try {",
              "          resolve(response.json());",
              "        } catch (_) {",
              "          resolve(null);",
              "        }",
              "        return;",
              "      }",
              "",
              "      if (status === 409) {",
              "        resolve({ conflict: true });",
              "        return;",
              "      }",
              "",
              "      reject(new Error(`${method} ${path} failed with HTTP ${status}: ${response.text()}`));",
              "    });",
              "  });",
              "}",
              "",
              "async function getOrCreateNestedCategory(path) {",
              "  let parent = null;",
              "  for (const name of path) {",
              "    const categories = await request('GET', '/api/v1/catalog/categories');",
              "    const existing = categories.find((category) =>",
              "      category.name === name &&",
              "      ((parent === null && category.parentId === null) || (parent !== null && category.parentId === parent.id))",
              "    );",
              "",
              "    if (existing) {",
              "      parent = existing;",
              "      continue;",
              "    }",
              "",
              "    parent = await request('POST', '/api/v1/catalog/categories', {",
              "      name,",
              "      parentId: parent ? parent.id : null",
              "    });",
              "  }",
              "",
              "  return parent;",
              "}",
              "",
              "async function getOrCreateBrand(name) {",
              "  const brands = await request('GET', '/api/v1/catalog/brands');",
              "  const existing = brands.find((brand) => brand.name === name);",
              "  if (existing) {",
              "    return existing;",
              "  }",
              "",
              "  return request('POST', '/api/v1/catalog/brands', { name });",
              "}",
              "",
              "async function getOrCreateProduct(product) {",
              "  const search = encodeURIComponent(product.name);",
              "  const page = await request('GET', `/api/v1/catalog/products?includeInactive=true&pageSize=100&search=${search}`);",
              "  const existing = (page.items || []).find((item) => item.name === product.name);",
              "",
              "  const body = {",
              "    categoryId: product.categoryId,",
              "    brandId: product.brandId,",
              "    name: product.name,",
              "    productType: product.productType || 'Lens',",
              "    expiryType: 'Batch',",
              "    sealedExpiryDuration: product.sealedExpiryDuration || null,",
              "    openedExpiryRate: product.openedExpiryRate || null,",
              "    openedExpiryDuration: product.openedExpiryDuration || null,",
              "    piecesPerPack: product.piecesPerPack,",
              "    sellMode: product.sellMode,",
              "    clinicalParams: product.clinicalParams == null ? null : JSON.stringify(product.clinicalParams),",
              "    extendedAttributes: product.extendedAttributes == null ? null : JSON.stringify(product.extendedAttributes)",
              "  };",
              "",
              "  if (existing) {",
              "    return request('PUT', `/api/v1/catalog/products/${existing.id}`, body);",
              "  }",
              "",
              "  return request('POST', '/api/v1/catalog/products', body);",
              "}",
              "",
              "function absolutePowerValues(maximum) {",
              "  const values = [];",
              "  for (let power = 0.5; power <= maximum + 0.0001;) {",
              "    values.push(Number(power.toFixed(2)));",
              "    power += power < 5 ? 0.25 : 0.5;",
              "  }",
              "  return values;",
              "}",
              "",
              "function powerGrid(minimum, maximum, includeZero) {",
              "  const negative = absolutePowerValues(Math.abs(minimum))",
              "    .map((value) => ({ powerSign: '-', powerValue: value }));",
              "  const positive = absolutePowerValues(maximum)",
              "    .map((value) => ({ powerSign: '+', powerValue: value }));",
              "  const zero = includeZero ? [{ powerSign: '+', powerValue: 0 }] : [];",
              "",
              "  return negative.concat(zero, positive);",
              "}",
              "",
              "async function addSku(product, power, colorName, size) {",
              "  const result = await request('POST', `/api/v1/catalog/products/${product.id}/skus`, {",
              "    powerSign: power.powerSign,",
              "    powerValue: power.powerValue,",
              "    colorName,",
              "    size,",
              "    barcode: null",
              "  });",
              "",
              "  return result && result.conflict ? 'exists' : 'created';",
              "}",
              "",
              "async function deactivateStaleSkus(product, shouldKeep) {",
              "  const detail = await request('GET', `/api/v1/catalog/products/${product.id}`);",
              "  let deactivated = 0;",
              "  for (const sku of detail.skus || []) {",
              "    if (sku.isActive && !shouldKeep(sku)) {",
              "      await request('PATCH', `/api/v1/catalog/skus/${sku.id}/deactivate`);",
              "      deactivated++;",
              "    }",
              "  }",
              "  return deactivated;",
              "}",
              "",
              "async function deactivateGlobalSeedSkuConflicts(targets) {",
              "  const page = await request('GET', '/api/v1/catalog/products?includeInactive=true&pageSize=1000');",
              "  let deactivated = 0;",
              "  for (const product of page.items || []) {",
              "    const detail = await request('GET', `/api/v1/catalog/products/${product.id}`);",
              "    for (const sku of detail.skus || []) {",
              "      if (!sku.isActive) {",
              "        continue;",
              "      }",
              "      const seededCode = sku.skuCode.startsWith('CV-ML-') || sku.skuCode.startsWith('CV-CL-') || sku.skuCode.startsWith('CV-PCS-') || sku.skuCode.startsWith('LAN-PM-');",
              "      const seededShape = (sku.colorName === 'Plain' && ['Box 3', 'Vial 1'].includes(sku.size)) || (colors.includes(sku.colorName) && sku.size === 'Pack 2') || (targets.solutionSizes.includes(sku.size) && sku.colorName == null);",
              "      if (!seededCode && !seededShape) {",
              "        continue;",
              "      }",
              "      const keep =",
              "        (targets.plainBoxes.some((product) => product.id === detail.id) && sku.skuCode.startsWith('CV-ML-') && sku.colorName === 'Plain' && sku.size === 'Box 3') ||",
              "        (targets.plainVials.some((product) => product.id === detail.id) && sku.skuCode.startsWith('CV-ML-') && sku.colorName === 'Plain' && sku.size === 'Vial 1') ||",
              "        (targets.coloredPacks.some((product) => product.id === detail.id) && sku.skuCode.startsWith('CV-CL-') && colors.includes(sku.colorName) && sku.size === 'Pack 2') ||",
              "        (detail.id === targets.sampleSolution.id && sku.skuCode.startsWith('CV-PCS-') && targets.solutionSizes.includes(sku.size));",
              "      if (!keep) {",
              "        await request('PATCH', `/api/v1/catalog/skus/${sku.id}/deactivate`);",
              "        deactivated++;",
              "      }",
              "    }",
              "  }",
              "  return deactivated;",
              "}",
              "",
              "async function runSeed() {",
              "  const medicalCategory = await getOrCreateNestedCategory(['Lenses', 'Medical Lenses']);",
              "  const coloredCategory = await getOrCreateNestedCategory(['Lenses', 'Colored Lenses']);",
              "  const solutionCategory = await getOrCreateNestedCategory(['Solution']);",
              "  const clearVision = await getOrCreateBrand('Clear Vision');",
              "",
              "  const medicalYearlySpecs = [",
              "    { label: '1 Year', duration: '1 year', rate: 'Annual' },",
              "    { label: '3 Years', duration: '3 years', rate: 'Annual' },",
              "    { label: '5 Years', duration: '5 years', rate: 'Annual' }",
              "  ];",
              "  const plainBoxValidityProducts = [];",
              "  const plainVialValidityProducts = [];",
              "  for (const spec of medicalYearlySpecs) {",
              "    plainBoxValidityProducts.push(await getOrCreateProduct({",
              "      name: `Plain Medical Lens Box - ${spec.label}`,",
              "      categoryId: medicalCategory.id,",
              "      brandId: clearVision.id,",
              "      productType: 'Lens',",
              "      piecesPerPack: 3,",
              "      sellMode: 'SealedPackOnly',",
              "      sealedExpiryDuration: spec.duration,",
              "      openedExpiryRate: spec.rate,",
              "      openedExpiryDuration: spec.duration,",
              "      clinicalParams: { powerRange: 'plainMedical', packaging: 'Box', duration: 'yearly' },",
              "      extendedAttributes: { seed: 'medical-lenses-postman', packageCode: 'BOX3', validity: spec.duration }",
              "    }));",
              "    plainVialValidityProducts.push(await getOrCreateProduct({",
              "      name: `Plain Medical Lens Vial - ${spec.label}`,",
              "      categoryId: medicalCategory.id,",
              "      brandId: clearVision.id,",
              "      productType: 'Lens',",
              "      piecesPerPack: 1,",
              "      sellMode: 'SealedPackOnly',",
              "      sealedExpiryDuration: spec.duration,",
              "      openedExpiryRate: spec.rate,",
              "      openedExpiryDuration: spec.duration,",
              "      clinicalParams: { powerRange: 'plainMedical', packaging: 'Vial', duration: 'yearly' },",
              "      extendedAttributes: { seed: 'medical-lenses-postman', packageCode: 'VIAL1', validity: spec.duration }",
              "    }));",
              "  }",
              "",
              "  const coloredValiditySpecs = [",
              "    { label: '3 Months', duration: '3 months', rate: 'Monthly' },",
              "    { label: '6 Months', duration: '6 months', rate: 'Monthly' },",
              "    { label: '9 Months', duration: '9 months', rate: 'Monthly' },",
              "    { label: '1 Day', duration: '1 day', rate: 'Daily' },",
              "    { label: '5 Days', duration: '5 days', rate: 'Daily' },",
              "    { label: '7 Days', duration: '7 days', rate: 'Daily' }",
              "  ];",
              "  const coloredValidityProducts = [];",
              "  for (const spec of coloredValiditySpecs) {",
              "    coloredValidityProducts.push(await getOrCreateProduct({",
              "      name: `Clear Vision Colored Lens Pack - ${spec.label}`,",
              "      categoryId: coloredCategory.id,",
              "      brandId: clearVision.id,",
              "      productType: 'Lens',",
              "      piecesPerPack: 2,",
              "      sellMode: 'SinglePiece',",
              "      sealedExpiryDuration: spec.duration,",
              "      openedExpiryRate: spec.rate,",
              "      openedExpiryDuration: spec.duration,",
              "      clinicalParams: { powerRange: 'coloredMedical', duration: spec.duration },",
              "      extendedAttributes: { seed: 'medical-lenses-postman', packageCode: 'PACK2', validity: spec.duration }",
              "    }));",
              "  }",
              "",
              "  const sampleSolution = await getOrCreateProduct({",
              "    name: 'Clear Vision Multi-Purpose Solution',",
              "    categoryId: solutionCategory.id,",
              "    brandId: clearVision.id,",
              "    productType: 'Solution',",
              "    piecesPerPack: 1,",
              "    sellMode: 'SinglePiece',",
              "    clinicalParams: null,",
              "    extendedAttributes: { seed: 'medical-lenses-postman', sample: true }",
              "  });",
              "",
              "  let created = 0;",
              "  let existing = 0;",
              "  let deactivated = 0;",
              "  const solutionSizes = ['60ml', '120ml', '250ml', '360ml'];",
              "  deactivated += await deactivateGlobalSeedSkuConflicts({ plainBoxes: plainBoxValidityProducts, plainVials: plainVialValidityProducts, coloredPacks: coloredValidityProducts, sampleSolution, solutionSizes });",
              "  for (const product of plainBoxValidityProducts) {",
              "    deactivated += await deactivateStaleSkus(product, (sku) => sku.skuCode.startsWith('CV-ML-') && sku.colorName === 'Plain' && sku.size === 'Box 3');",
              "  }",
              "  for (const product of plainVialValidityProducts) {",
              "    deactivated += await deactivateStaleSkus(product, (sku) => sku.skuCode.startsWith('CV-ML-') && sku.colorName === 'Plain' && sku.size === 'Vial 1');",
              "  }",
              "  for (const product of coloredValidityProducts) {",
              "    deactivated += await deactivateStaleSkus(product, (sku) => sku.skuCode.startsWith('CV-CL-') && colors.includes(sku.colorName) && sku.size === 'Pack 2');",
              "  }",
              "  deactivated += await deactivateStaleSkus(sampleSolution, (sku) => sku.skuCode.startsWith('CV-PCS-') && solutionSizes.includes(sku.size));",
              "  const plainPowers = powerGrid(-20, 10, false);",
              "  const medicalValiditySkuSpecs = [",
              "    ...plainBoxValidityProducts.map((product) => ({ product, size: 'Box 3' })),",
              "    ...plainVialValidityProducts.map((product) => ({ product, size: 'Vial 1' }))",
              "  ];",
              "  for (const power of plainPowers) {",
              "    for (const spec of medicalValiditySkuSpecs) {",
              "      const result = await addSku(spec.product, power, 'Plain', spec.size);",
              "      result === 'created' ? created++ : existing++;",
              "    }",
              "  }",
              "",
              "  const coloredPowers = powerGrid(-10, 10, true);",
              "  for (const product of coloredValidityProducts) {",
              "    for (const color of colors) {",
              "      for (const power of coloredPowers) {",
              "        const result = await addSku(product, power, color, 'Pack 2');",
              "        result === 'created' ? created++ : existing++;",
              "      }",
              "    }",
              "  }",
              "",
              "  for (const size of solutionSizes) {",
              "    const result = await addSku(sampleSolution, { powerSign: null, powerValue: null }, null, size);",
              "    result === 'created' ? created++ : existing++;",
              "  }",
              "",
              "  const sampleSolutionDetail = await request('GET', `/api/v1/catalog/products/${sampleSolution.id}`);",
              "  const plainBoxValidityCounts = [];",
              "  for (const product of plainBoxValidityProducts) {",
              "    const detail = await request('GET', `/api/v1/catalog/products/${product.id}`);",
              "    plainBoxValidityCounts.push(detail.skus.filter((sku) => sku.isActive && sku.colorName === 'Plain' && sku.size === 'Box 3').length);",
              "  }",
              "  const plainVialValidityCounts = [];",
              "  for (const product of plainVialValidityProducts) {",
              "    const detail = await request('GET', `/api/v1/catalog/products/${product.id}`);",
              "    plainVialValidityCounts.push(detail.skus.filter((sku) => sku.isActive && sku.colorName === 'Plain' && sku.size === 'Vial 1').length);",
              "  }",
              "  const coloredValidityCounts = [];",
              "  for (const product of coloredValidityProducts) {",
              "    const detail = await request('GET', `/api/v1/catalog/products/${product.id}`);",
              "    coloredValidityCounts.push(detail.skus.filter((sku) => sku.isActive && sku.size === 'Pack 2' && colors.includes(sku.colorName)).length);",
              "  }",
              "  const solutionCount = sampleSolutionDetail.skus.filter((sku) => sku.isActive && solutionSizes.includes(sku.size)).length;",
              "",
              "  return {",
              "    created,",
              "    existing,",
              "    deactivated,",
              "    expectedPlainPerProduct: plainPowers.length,",
              "    expectedColoredTotal: coloredPowers.length * colors.length,",
              "    counts: {",
              "      plainBoxValidity: plainBoxValidityCounts,",
              "      plainVialValidity: plainVialValidityCounts,",
              "      coloredValidity: coloredValidityCounts,",
              "      sampleSolution: solutionCount",
              "    },",
              "    products: {",
              "      plainBoxValidity: plainBoxValidityProducts.map((product) => product.id),",
              "      plainVialValidity: plainVialValidityProducts.map((product) => product.id),",
              "      coloredValidity: coloredValidityProducts.map((product) => product.id),",
              "      sampleSolution: sampleSolution.id",
              "    }",
              "  };",
              "}",
              "",
              "return runSeed()",
              "  .then((summary) => {",
              "    pm.collectionVariables.set('lensSeedSummary', JSON.stringify(summary));",
              "    console.log('Lens seed summary', summary);",
              "    pm.test('Lens seed completed', function () {",
              "      pm.expect(summary.expectedPlainPerProduct).to.eql(75);",
              "      pm.expect(summary.expectedColoredTotal).to.eql(708);",
              "      pm.expect(summary.counts.plainBoxValidity).to.have.length(3);",
              "      pm.expect(summary.counts.plainVialValidity).to.have.length(3);",
              "      summary.counts.plainBoxValidity.forEach((count) => pm.expect(count).to.eql(75));",
              "      summary.counts.plainVialValidity.forEach((count) => pm.expect(count).to.eql(75));",
              "      pm.expect(summary.counts.coloredValidity).to.have.length(6);",
              "      summary.counts.coloredValidity.forEach((count) => pm.expect(count).to.eql(708));",
              "      pm.expect(summary.counts.sampleSolution).to.eql(4);",
              "    });",
              "  })",
              "  .catch((error) => {",
              "    pm.test('Lens seed completed', function () {",
              "      throw error;",
              "    });",
              "  });"
            ]
          }
        }
      ]
    }
  ]
}
