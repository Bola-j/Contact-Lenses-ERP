APP_DOMAIN=lensee.example.com
TLS_EMAIL=admin@example.com

DB_PASSWORD=replace-with-a-long-random-database-password
DB_HOST_PORT=8181

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=Lensee
JWT_AUDIENCE=Lensee.App
SHOPIFY_ENABLED=false
# Replace with the permanent myshopify.com domain shown under Shopify Settings > Domains.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Inject Shopify's app client secret for the ERP-owned app into ERP secret storage.
SHOPIFY_WEBHOOK_SECRET=
# Compatibility-only; leave empty. Production requires signed HMAC webhooks.
SHOPIFY_LEGACY_WEBHOOK_PATH_SECRET=
# UUID of the active Online location in the ERP.
SHOPIFY_ONLINE_LOCATION_ID=
# Leave blank unless COD is deliberately configured later.
SHOPIFY_COD_GATEWAY_NAME_1=
SHOPIFY_WEBHOOK_MAX_BODY_BYTES=262144
SHOPIFY_PAYLOAD_RETENTION_DAYS=30
# Leave blank to record the first enabled startup as the forward-only cutoff.
SHOPIFY_ACTIVATION_AT_UTC=
# Optional missed-event recovery. Enable only after adding an Admin API token to secret storage.
SHOPIFY_RECONCILIATION_ENABLED=false
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2026-07
SHOPIFY_RECONCILIATION_INTERVAL_MINUTES=15
HOSTING_TRUSTED_PROXY_NETWORK=<caddy-docker-network-cidr>

ASPNETCORE_ENVIRONMENT=Production
FRONTEND_API_BASE_URL=https://lensee.example.com
CORS_ALLOWED_ORIGINS=https://lensee.example.com

# Keep application instances in validation-only mode. Apply migrations through the explicit migrator command.
DATABASE_AUTO_MIGRATE=false
DATABASE_BASELINE_EXISTING_SCHEMA=false

RATE_LIMITING_PERMIT_LIMIT=120
RATE_LIMITING_WINDOW_SECONDS=60
RATE_LIMITING_QUEUE_LIMIT=0

REPORTING_MAX_EXPORT_ROWS=10000
REPORTING_QUESTPDF_LICENSE=Community
REPORTING_COMPANY_NAME_AR=لينسي
REPORTING_COMPANY_NAME_EN=Lensee
# Optional PNG/JPEG logo bytes encoded as a single-line base64 value.
REPORTING_LOGO_BASE64=
REPORTING_ADDRESS_AR=
REPORTING_ADDRESS_EN=
REPORTING_PHONE=
REPORTING_TAX_NUMBER=
REPORTING_COMMERCIAL_REGISTRATION=
REPORTING_CURRENCY_CODE=EGP
