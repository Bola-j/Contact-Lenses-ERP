APP_DOMAIN=lensee.example.com
TLS_EMAIL=admin@example.com

DB_PASSWORD=replace-with-a-long-random-database-password
DB_HOST_PORT=8181

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=Lensee
JWT_AUDIENCE=Lensee.App
SHOPIFY_ENABLED=false
# Inject SHOPIFY_WEBHOOK_SECRET from the production secret store, not source control.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_STORE_DOMAIN=<your-store>.myshopify.com
SHOPIFY_ONLINE_LOCATION_ID=
SHOPIFY_COD_GATEWAY_NAME_1=Cash on Delivery
SHOPIFY_WEBHOOK_MAX_BODY_BYTES=262144
SHOPIFY_PAYLOAD_RETENTION_DAYS=30
HOSTING_TRUSTED_PROXY_NETWORK=<caddy-docker-network-cidr>

ASPNETCORE_ENVIRONMENT=Production
FRONTEND_API_BASE_URL=https://lensee.example.com
CORS_ALLOWED_ORIGINS=https://lensee.example.com

DATABASE_AUTO_MIGRATE=true
DATABASE_BASELINE_EXISTING_SCHEMA=false

RATE_LIMITING_PERMIT_LIMIT=120
RATE_LIMITING_WINDOW_SECONDS=60
RATE_LIMITING_QUEUE_LIMIT=0
